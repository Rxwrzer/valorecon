{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ValoRecon",
  "version": "0.2.2",
  "identifier": "com.rxwr.valorecon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ValoRecon",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0c0d12",
        "decorations": true,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNURCQ0YxQjlBMDY4OQpSV1NKQnBvYno5dWxDR1I0ZUY0NDBjb2FkTmJxK1hockwvd1NMM2xiNHhBbHVGN1FrMlhDSXZ5RQo=",
      "endpoints": [
        "https://github.com/Rxwrzer/valorecon/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
